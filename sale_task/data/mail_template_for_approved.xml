<odoo>
    <data>

        <record id="email_template_sale_order_approved" model="mail.template">
            <field name="name">Sale Order Confirmed Email</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Your Sale Order is Approved</field>
            <field name="email_from">${(user.email_formatted)}</field>
            <field name="email_to">${object.email}</field>

           
            <field name="body_html" type="html">

                <p>Hello <t t-esc="object.partner_id.name"/>,</p>

                <p>Your sale order <strong> <t t-esc="object.name"/></strong> has been approved.</p>

                <p>Total: <strong> <t t-esc="object.amount_total"/></strong></p>

                <p>Thank you!</p>
            </field>

        </record>

    </data>
</odoo>

 <!-- Create a custom email template for sale.order that sends a summary of the order (customer, total, order number) when the order is approved. 
PDF Name should be summary report  
Same as it is you have to create a xls Report 
Visible this menu under PDF
 -->
