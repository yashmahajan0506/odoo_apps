<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_form_approval" model="ir.ui.view">
        <field name="name">sale.order.form.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">

                <button name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        groups="sales_team.group_sale_manager"
                        invisible="state != 'waiting_approval'"/>

                <button name="action_confirm_after_approval"
                        string="Confirm"
                        type="object"
                        class="btn-success"
                        invisible="state != 'approved'"/>
            </xpath>

            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">
                    draft,waiting_approval,approved,sale
                </attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="attachment_ids" widget="many2many_binary"/>
                <field name="attachment_ids" widget="attachment_preview" string=" "/>
            </xpath>

        </field>
    </record>

</odoo>
