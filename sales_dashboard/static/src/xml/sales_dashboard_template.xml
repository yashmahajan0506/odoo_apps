<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="sales_dashboard.SalesDashboardMain">
   
        <div class="o_sales_dashboard container-fluid overflow-auto h-100" t-att-class="state.theme">

            <div class="d-flex align-items-center mb-3">
                <!-- Left: Title -->
                <h2 class="mb-0 text-nowrap">Sales Dashboard</h2>

                <!-- Center: Search Bar -->
                <div class="flex-grow-1 d-flex justify-content-center mx-4">
                    <div class="w-50">
                        <CustomSaleSmartFilter onFilterChange.bind="handleFilterUpdate"/>
                    </div>
                </div>

                <!-- Right: Theme Toggle -->
                 <div class="d-flex align-items-center gap-3 text-nowrap">
                    <label class="theme-switch">
                        <input type="checkbox"
                               t-att-checked="state.theme === 'dark'"
                               t-on-change="toggleTheme"/>
                        <span class="slider"></span>
                    </label>

                    <span class="toggle-label">
                        <t t-if="state.theme === 'light'">Light Mode</t>
                        <t t-if="state.theme === 'dark'">Dark Mode</t>
                    </span>
                </div>
            </div>


            <!-- Main Content: KPI Cards -->
            <div class="row">
                <div class="col-12">
                    <div class="row g-3 text-center">
                        <!-- KPI 1: Total Orders -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <div class="card kpi-card card-total">
                                <div class="card-body">
                                    <h5 class="kpi-title">
                                        <i class="fa fa-shopping-cart kpi-icon"></i> Total Orders
                                    </h5>
                                    <div class="kpi-value" t-esc="state.total_orders"/>
                                    <div class="kpi-sub">All orders</div>
                                </div>
                            </div>
                        </div>

                        <!-- KPI 2: Confirmed Orders -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <div class="card kpi-card card-confirmed">
                                <div class="card-body">
                                    <h5 class="kpi-title">
                                        <i class="fa fa-check-circle kpi-icon"></i> Confirmed Orders
                                    </h5>
                                    <div class="kpi-value" t-esc="state.confirmed_orders"/>
                                    <div class="kpi-sub">Confirmed (sale)</div>
                                </div>
                            </div>
                        </div>

                        <!-- KPI 3: Quotations -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <div class="card kpi-card card-quotation">
                                <div class="card-body">
                                    <h5 class="kpi-title">
                                        <i class="fa fa-file-alt kpi-icon"></i> Quotations
                                    </h5>
                                    <div class="kpi-value" t-esc="state.quotations"/>
                                    <div class="kpi-sub">Draft / Quotations</div>
                                </div>
                            </div>
                        </div>

                        <!-- KPI 4: Total Revenue -->
                        <div class="col-12 col-sm-6 col-md-3">
                            <div class="card kpi-card card-revenue">
                                <div class="card-body">
                                    <h5 class="kpi-title">
                                        <i class="fa fa-dollar-sign kpi-icon"></i> Total Revenue
                                    </h5>
                                    <div class="kpi-value" t-esc="state.total_amount"/>
                                    <div class="kpi-sub">Confirmed order revenue</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Section (Premium Look) -->
            <div class="row mt-5">
                <!-- Pie Chart -->
                <div class="col-12 col-md-6 mb-4">
                    <div class="card shadow-lg border-0 h-100" style="border-radius: 20px; overflow: hidden;">
                        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                            <h4 class="card-title fw-bold text-dark mb-0">Order Distribution</h4>
                            <small class="text-muted">Quotations vs Confirmed Orders</small>
                        </div>
                        <div class="card-body d-flex justify-content-center align-items-center" style="height: 400px;">
                            <canvas t-ref="pieChart" style="max-height: 100%; max-width: 100%;"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Bar Chart -->
                <div class="col-12 col-md-6 mb-4">
                    <div class="card shadow-lg border-0 h-100" style="border-radius: 20px; overflow: hidden;">
                        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                            <h4 class="card-title fw-bold text-dark mb-0">Sales Performance</h4>
                            <small class="text-muted">Total Orders vs Total Revenue</small>
                        </div>
                        <div class="card-body d-flex justify-content-center align-items-center" style="height: 400px;">
                            <canvas t-ref="barChart" style="max-height: 100%; max-width: 100%;"></canvas>
                        </div>
                    </div>
                </div>
            </div>



            <!-- SECTION: Quick Actions / Widget Area -->
            <div class="row g-4 mt-4">
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card action-card h-100">
                        <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                            <h5 class="action-title mb-4">
                                <i class="fa fa-calculator me-2"></i> Quick Counter
                            </h5>
                            
                            <div class="counter-wrapper p-3 rounded-pill">
                                <CounterWidget
                                    t-props="{
                                            value: state.total_orders,
                                            onChange: (val) => state.total_orders = val
                                    }"/>
                            </div>
                            <div class="text-muted mt-3 small">Adjust total orders manually</div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-8">
                     <div class="card action-card h-100 d-flex justify-content-center align-items-center opacity-50 border-dashed">
                         <div class="text-center p-5">
                             <i class="fa fa-plus-circle fa-2x mb-2"></i>
                             <p>Add more widgets here</p>
                         </div>
                     </div>
                </div>
            </div>
        </div>
    </t>
</templates>
