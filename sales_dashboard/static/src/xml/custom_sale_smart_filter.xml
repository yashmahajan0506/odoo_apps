<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="custom_sale_smart_filter.CustomSaleSmartFilter">
        <div class="custom-smart-filter position-relative w-100" t-att-class="props.isDialog ? 'p-1' : ''">
            <!-- Search Box -->
            <div class="input-group shadow-sm" t-att-class="props.isDialog ? 'mb-3' : ''">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="fa fa-search"/>
                </span>
                <input type="text"
                       class="form-control border-start-0 ps-0"
                       placeholder="Search orders..."
                       t-model="state.search"
                       t-on-input="onSearchInput"
                       t-on-keydown="onKeyDown"
                       t-on-focus="onFocus"/>
            </div>
            
            <!-- Panel -->
            <div t-att-class="props.isDialog ? 'filter-panel card w-100 border' : 'filter-panel card shadow position-absolute w-100 mt-1'"
                 t-att-style="props.isDialog ? '' : 'z-index: 1000;'"
                 t-if="state.isPanelVisible">
                <div class="card-header d-flex justify-content-between align-items-center bg-white">
                    <h5 class="mb-0 text-muted"><i class="fa fa-filter me-2"/>Smart Filters</h5>
                    <button type="button" class="btn-close" aria-label="Close" t-on-click="closePanel" t-if="!props.isDialog"></button>
                </div>
                <div class="card-body">
                    <div class="filter-section">
                        <label class="text-uppercase text-muted small fw-bold mb-2">Time Period</label>
                        <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                            <a href="#"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                               t-att-class="state.activeFilter === 'all' ? 'active fw-bold' : 'text-body'"
                               t-on-click="() => this.setFilter('all')">
                               <span>All Orders</span>
                               <i t-if="state.activeFilter === 'all'" class="fa fa-check"/>
                            </a>
                            <a href="#"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                               t-att-class="state.activeFilter === 'last_7_days' ? 'active fw-bold' : 'text-body'"
                               t-on-click="() => this.setFilter('last_7_days')">
                               <span>Last 7 Days</span>
                               <i t-if="state.activeFilter === 'last_7_days'" class="fa fa-check"/>
                            </a>
                            <a href="#"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                               t-att-class="state.activeFilter === 'last_30_days' ? 'active fw-bold' : 'text-body'"
                               t-on-click="() => this.setFilter('last_30_days')">
                               <span>Last 30 Days</span>
                               <i t-if="state.activeFilter === 'last_30_days'" class="fa fa-check"/>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
