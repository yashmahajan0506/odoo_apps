<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="sales_dashboard.CounterWidget">
        <div class="counter-widget d-flex align-items-center gap-2">

            <button class="btn btn-sm btn-secondary"
                    t-on-click="decrement">-</button>

            <span class="counter-value" t-esc="state.value"/>

            <button class="btn btn-sm btn-primary"
                    t-on-click="increment">+</button>

        </div>
    </t>

</templates>
