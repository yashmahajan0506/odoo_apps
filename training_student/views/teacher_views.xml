<odoo>
    <record id="view_training_teacher_form" model="ir.ui.view">
        <field name="name">training.teacher.form</field>
        <field name="model">training.teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="expertise"/>
                        <field name="student_ids"/>
                        <field name="student_count" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_training_teacher_tree" model="ir.ui.view">
        <field name="name">training.teacher.list</field>
        <field name="model">training.teacher</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="expertise"/>
                <field name="student_count"/>
            </list>
        </field>
    </record>
</odoo>
