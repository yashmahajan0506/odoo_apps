<?xml version="1.0" encoding="utf-8"?>
<odoo>

      <record id="view_student_list" model="ir.ui.view">
        <field name="name">student.list</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <list string='students'>
                <field name="name"/>
                <field name="age"/>
                <field name="course"/>
                <field name="state"/>
            </list>
        </field>
    </record>

       <record id="view_student_form" model="ir.ui.view">
        <field name="name">student.student.form</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <header>
                        <button name="action_draft" type="object" string="Draft"
                            class="btn-primary"/>
                        <button name="action_confirmed" type="object" string="Confirmed"
                            class="btn-primary"/>
                         <button name="action_alumni" type="object" string="Alumni"
                            class="btn-primary"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,alumni"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="age"/>
                            <field name="course"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_student_kanban" model="ir.ui.view">
        <field name="name">student.kanban</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <kanban>
           <templates>
        <t t-name="kanban-box">
            <div class="oe_kanban_global_click o_kanban_record student_card">
                <div>Name: <field name="name"/></div>
                <div>Age: <field name="age"/></div>
                <div>Course: <field name="course"/></div>
            </div>
        </t>
    </templates>
</kanban>

        </field>
    </record>
  

       <record id="student_graph" model="ir.ui.view">
        <field name="name">student.student.graph.course</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <graph string="Students by course" type="pie">
                <field name="course" type="row"/>
              
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>



    <record id="view_student_search" model="ir.ui.view">
    <field name="name">student.search</field>
    <field name="model">student.student</field>
    <field name="arch" type="xml">
        <search string="search students">
      
            <field name="name" string="Name"/>
            <field name="course" string="Course"/>
        
            <filter string="By Course" name="filter_by_course" context="{'group_by':'course'}"/>
        </search>
    </field>
</record>
</odoo>
