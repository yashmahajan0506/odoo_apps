<odoo>
    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">list,form,kanban,graph</field>
    </record>

      <record id="action_training_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">training.teacher</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_training_teacher_tree"/>
    </record>
  
    <menuitem id="menu_student_root" name="Student Management" sequence="10"/>

   
    <menuitem id="menu_student_menu" name="Students" parent="menu_student_root" action="action_student" sequence="20"/>
      <menuitem id="menu_training_teacher" name="Teachers" parent="menu_student_root" action="action_training_teacher" sequence="20"/>
</odoo>
