<odoo>
   
    <record id="student_rule_own" model="ir.rule">
        <field name="name">Student: See Own Record</field>
        <field name="model_id" ref="model_student_student"/>
        <field name="groups" eval="[(4, ref('training_student.group_student_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

   
    <record id="teacher_rule_students" model="ir.rule">
        <field name="name">Teacher: See Assigned Students</field>
        <field name="model_id" ref="model_student_student"/>
        <field name="groups" eval="[(4, ref('training_student.group_teacher_user'))]"/>
        <field name="domain_force">[('teacher_ids.user_id', '=', user.id)]</field>
    </record>

    
    <record id="teacher_rule_own_record" model="ir.rule">
        <field name="name">Teacher: See Own Record</field>
        <field name="model_id" ref="model_training_teacher"/>
        <field name="groups" eval="[(4, ref('training_student.group_teacher_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
</odoo>


