<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_student_event_list" model="ir.ui.view">
        <field name="name">student.event.list</field>
        <field name="model">student.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_ids" widget="many2many_tags"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_student_event_form" model="ir.ui.view">
        <field name="name">student.event.form</field>
        <field name="model">student.event</field>
        <field name="arch" type="xml">
            <form string="Student Event">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                          <field name="state"/>
                          <field name="student_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
