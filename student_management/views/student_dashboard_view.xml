<?xml version="1.0" encoding="utf-8"?>
 <odoo>
 
    <!-- OPTIONAL: safe placeholder view (no OWL directives) -->
<record id="view_student_dashboard_form" model="ir.ui.view">
    <field name="name">student.dashboard.form.safe</field>
    <field name="model">student.dashboard</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="total_students" readonly="1"/>
                    <field name="active_students" readonly="1"/>
                </group>
                <div>
                    <p>This is a safe fallback view. The real dashboard is served via client action.</p>
                </div>
            </sheet>
        </form>
    </field>
</record>

 
 </odoo>
 