    </record>

<record id="action_school_subject" model="ir.actions.act_window">
        <field name="name">subjects</field>
        <field name="res_model">school.subject</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_student_root" name="Student Management" sequence="10"/>
   
    
    <menuitem id="menu_student_dashboard_menu" name="Student Dashboard" parent="menu_student_root"  action="Action_student_dashboard_client" sequence="10"/>
