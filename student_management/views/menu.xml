<odoo>
    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">kanban,list,form,graph,calendar,pivot</field>
    </record>

    <record id="action_subject" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">school.subject</field>
        <field name="view_mode">kanban,list,form</field>    
    </record>

    <record id="action_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">list,form</field>
    </record>

     <record id="action_class" model="ir.actions.act_window"> 
         <field name="name">Configuration</field> 
         <field name="res_model">school.class</field> 
         <field name="view_mode">list,form</field> 
    </record>

    <record id="action_alumni_reason" model="ir.actions.act_window">
    <field name="name">Alumni Reasons</field>
    <field name="res_model">student.alumni.reason</field>
    <field name="view_mode">list,form</field>
    </record>

  
 <record id="Action_student_dashboard_client" model="ir.actions.client">
    <field name="name">Student Dashboard</field>
    <field name="tag">student_dashboard_action_js</field>
</record>

