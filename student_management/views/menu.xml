<odoo>
    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">kanban,list,form,graph,calendar,pivot</field>
    </record>

    <record id="action_subject" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">school.subject</field>
        <field name="view_mode">kanban,list,form</field>    
    </record>

    <record id="action_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">list,form</field>
    </record>

     <record id="action_class" model="ir.actions.act_window"> 
         <field name="name">Configuration</field> 
         <field name="res_model">school.class</field> 
         <field name="view_mode">list,form</field> 
    </record>

    <record id="action_alumni_reason" model="ir.actions.act_window">
    <field name="name">Alumni Reasons</field>
    <field name="res_model">student.alumni.reason</field>
    <field name="view_mode">list,form</field>
</record>

    
    
    <menuitem id="menu_student_root" name="Student Management" sequence="10"/>
    <menuitem id="menu_student_menu" name="Students" parent="menu_student_root" action="action_student" sequence="20"/>
    <menuitem id="menu_subject_menu" name="Courses" parent="menu_student_root" action="action_subject" sequence="30" groups="student_management.group_teacher_user,base.group_system"/>
    <menuitem id="menu_class_menu" name="Classes" parent="menu_student_root" action="action_class" sequence="40" groups="student_management.group_teacher_user,base.group_system"/>
    <menuitem id="menu_configuration_menu" name="Configuration" parent="menu_student_root" action="action_class" sequence="40"/>
    <menuitem id="menu_alumni_reason" name="Reasons" parent="menu_configuration_menu" action="action_alumni_reason" sequence="50"/>
</odoo>
