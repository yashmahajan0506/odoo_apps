 <record id="action_student_event" model="ir.actions.act_window">
        <field name="name">Student Events</field>
        <field name="res_model">student.event</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create student events.
            </p>
        </field>
    </record>

<record id="action_school_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">list,form</field>
    </record>
  
<record id="action_school_department" model="ir.actions.act_window">
        <field name="name">Department</field>
        <field name="res_model">school.department</field>
