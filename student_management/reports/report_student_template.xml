<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_student_template">
    <t t-call="web.html_container">
      <t t-call="web.external_layout">

        <h2 style="text-align:center; margin-top:10px;">Student Information:
        </h2>
         <t t-foreach="docs" t-as="doc">
        <table class="table table-sm table-bordered"
               style="width:100%; border-collapse:collapse; margin-top:15px;">
          <tbody>
            <tr>
              <th style="width:40%;">Student Name</th>
                 <td><t t-esc="doc.name"/></td>
            </tr>
            <tr>
              <th>Roll Number</th>
              <td><t t-esc="doc.roll_no"/></td>
            </tr>
            <tr>
              <th>Date of Birth</th>
               <td><t t-esc="doc.dob"/></td>
            </tr>
            <tr>
              <th>Gender</th>
             <td><t t-esc="doc.gender"/></td>
            </tr>
            <tr>
              <th>Age</th>
            <td><t t-esc="doc.age"/></td>
            </tr>
            <tr>
              <th>Class</th>
               <td><t t-esc="doc.class_id.name"/></td>
            </tr>
            <tr>
              <th>Class Teacher</th>
               <td><t t-esc="doc.class_id.class_teacher"/></td>
            </tr>
            <tr>
              <th>Section</th>
             <td><t t-esc="doc.class_id.section"/></td>
            </tr>
          </tbody>
        </table>

      </t>
    </t>
    </t>
  </template>

  <record id="action_student_report" model="ir.actions.report">
      <field name="name">Static Student Report</field>
      <field name="model">student.student</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">student_management.report_student_template</field>
      <field name="report_file">student_management.report_student_template</field>
  </record>
</odoo>
