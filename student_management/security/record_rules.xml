<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <record id="student_subject_line_rule_student" model="ir.rule">
            <field name="name">Student can see own subject lines</field>
            <field name="model_id" ref="model_student_subject_line"/>
            <field name="groups" eval="[(4, ref('student_management.group_student_user'))]"/>
            <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        </record>

        
        <record id="student_subject_line_rule_teacher" model="ir.rule">
            <field name="name">Teacher can see their students' subject lines</field>
            <field name="model_id" ref="model_student_subject_line"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

