        <record id="rule_student_see_own" model="ir.rule">
    <field name="name">Student: See Own Record Only</field>
    <field name="model_id" ref="model_student_student"/>
    <field name="domain_force">[('user_id', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('student_management.group_student_user'))]"/>
</record>


        <record id="rule_teacher_see_all" model="ir.rule">
            <field name="name">Teacher: See All Students</field>
            <field name="model_id" ref="model_student_student"/>
            <!-- <field name="domain_force">[(1, '=', 1)]</field> -->
            <field name="groups" eval="[(4, ref('student_management.group_teacher_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_admin_see_all" model="ir.rule">
            <field name="name">Admin: See All Students</field>
            <field name="model_id" ref="model_student_student"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('student_management.group_student_admin'))]"/>
        </record>

    </data>
</odoo>
