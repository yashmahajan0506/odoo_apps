<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_alumni_wizard_form" model="ir.ui.view">
        <field name="name">student.alumni.wizard.form</field>
        <field name="model">student.alumni.wizard</field>
        <field name="arch" type="xml">
            <form string="Move to Alumni">
                <group>
                    <field name="reason" placeholder="Enter reason..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_student_alumni_wizard" model="ir.actions.act_window">
        <field name="name">Alumni Reason Wizard</field>
        <field name="res_model">student.alumni.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
