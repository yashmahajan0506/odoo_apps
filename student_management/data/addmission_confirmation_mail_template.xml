<odoo>
    <record id="student_creation_email_template" model="mail.template">
        <field name="name">Student Created Confirmation</field>
        <field name="model_id" ref="student_management.model_student_student"/>
        <field name="subject">Your Student Account Has Been Created</field>
        <field name="email_from">${(user.email_formatted or user.email)|safe}</field>

        <field name="email_to">${object.email}</field>

        <field name="body_html" type="html">

                <p>Hello <t t-esc="object.name"/></p>

                <p>Your student account has been created successfully!</p>
     
                 <p><strong>Details:</strong></p>
                <ul>
                    <li>Name: <t t-esc="object.name"/></li>
                    <li>Email: <t t-esc="object.email"/></li>
                    <li>Roll No:  <t t-esc="object.roll_no"/></li>
                </ul>

                <p>Thank you</p>
        </field>
