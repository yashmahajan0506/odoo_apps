<?xml version="1.0" encoding="utf-8"?>
<odoo>
         <record id="email_template_student_birthday" model="mail.template">
            <field name="name">Student Birthday Wishes</field>
            <field name="model_id" ref="student_management.model_student_student"/>
            <field name="subject">Happy Birthday,{{object.name}}</field>
            <field name="email_from"> no-reply@yourcompany.com</field>
            <field name="email_to">{{ object.email }}</field>

            <field name="body_html" type="html">
             <span>Happy birhtday!!! <t t-esc="object.name"/></span>
     
            <p>This is a message from your teacher.</p>
            <p>Here are your details:</p>
        </field>
         </record>
</odoo>
