<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="student_management.StudentDashboardMain">

        <link rel="stylesheet"
              href="/student_management/static/src/css/dashboard.css"/>

        <div class="student-dashboard-container container mt-4">
            <div class="dashboard-animated-bg"></div>

            <h2 class="text-center mb-4 dashboard-title">
                🎓 Student Analytics Dashboard
            </h2>
        
<div class="d-flex justify-content-center mb-4">

        <div class="input-group w-50">
         <input type="text" class="form-control"
                placeholder="Search students..."
                t-att-value="state.searchQuery"
                t-on-input="onSearchInput"/>
        
         <button class="btn btn-outline-primary"
                 t-on-click="performSearch">
             Search
         </button>
    </div>


    <div>
        <select class="form-select w-auto" t-model="state.selectedFilter" t-on-change="applyFilter">
            <option value="">-- Filter By --</option>
            <option value="active">Active Students</option>
            <option value="male">Male Students</option>
            <option value="female">Female Students</option>
            <option value="department">Departments</option>
            <option value="subject">Subjects</option>
        </select>
    </div>

</div>

     
    <div class="d-flex justify-content-between align-items-center mb-3">


    <div class="d-flex gap-2">
        <button type="button" class="btn btn-secondary" t-on-click="addStudent">
            ➕ Add Student
        </button>
    
        <button type="button" class="btn btn-secondary" t-on-click="addDepartment">
            ➕ Add Department
        </button>
    
        <button type="button" class="btn btn-secondary" t-on-click="addSubject">
            ➕ Add Subject
        </button>
    </div>


    <div>
        <button class="btn btn-primary" t-on-click="downloadDashboardPDF">
            📄 Download Dashboard
        </button>
    </div>

</div>


         <!-- <div class="d-flex justify-content-end mb-3">
                 
            </div> -->


            <div class="row g-4">

                <div class="col-md-3">
                    <div class="dash-card"
                         t-on-click="(ev) => this.openStudentList(ev, 'all')">
                        <h5>Total Students</h5>
                        <div class="value" t-esc="state.total_students"/>
                    </div>
                </div>


                <div class="col-md-3">
                    <div class="dash-card"
                         t-on-click="(ev) => this.openStudentList(ev, 'active')">
                        <h5>Active Students</h5>
                        <div class="value" t-esc="state.active_students"/>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="dash-card"
                         t-on-click="(ev) => this.openStudentList(ev, 'department')">
                        <h5>Department</h5>
                        <div class="value" t-esc="state.department_count"/>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="dash-card"
                         t-on-click="(ev) => this.openStudentList(ev, 'subject')">
                        <h5>Subjects</h5>
                        <div class="value" t-esc="state.subject_count"/>
                    </div>
                </div>

            </div>

            <!-- CHARTS -->
            <div class="row mt-5">

                <div class="col-md-6">
                    <div class="chart-box">
                        <h5 class="text-center">Gender Breakdown</h5>
                        <canvas id="pieChart"></canvas>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="chart-box">
                        <h5 class="text-center">Total vs Active</h5>
                        <canvas id="barChart"></canvas>
                    </div>
                </div>

            </div>

        </div>

        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    </t>

</templates>
