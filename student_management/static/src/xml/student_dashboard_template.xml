<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="student_management.StudentDashboardMain">

        <link rel="stylesheet"
              href="/student_management/static/src/css/dashboard.css"/>

        <div class="student-dashboard-container container mt-4">
            <div class="dashboard-animated-bg"></div>

            <h2 class="text-center mb-4 dashboard-title">
                🎓 Student Analytics Dashboard
            </h2>

            <!-- CARDS -->
            <div class="row g-4">

                <div class="col-md-3">
                    <div class="dash-card"
                         t-on-click="(ev) => this.openStudentList(ev, 'all')">
                        <h5>Total Students</h5>
                        <div class="value" t-esc="state.total_students"/>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="dash-card"
                         t-on-click="(ev) => this.openStudentList(ev, 'active')">
                        <h5>Active Students</h5>
                        <div class="value" t-esc="state.active_students"/>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="dash-card"
                         t-on-click="(ev) => this.openStudentList(ev, 'male')">
                        <h5>Male</h5>
                        <div class="value" t-esc="state.male_students"/>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="dash-card"
                         t-on-click="(ev) => this.openStudentList(ev, 'female')">
                        <h5>Female</h5>
                        <div class="value" t-esc="state.female_students"/>
                    </div>
                </div>

            </div>

            <!-- CHARTS -->
            <div class="row mt-5">

                <div class="col-md-6">
                    <div class="chart-box">
                        <h5 class="text-center">Gender Breakdown</h5>
                        <canvas id="pieChart"></canvas>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="chart-box">
                        <h5 class="text-center">Total vs Active</h5>
                        <canvas id="barChart"></canvas>
                    </div>
                </div>

            </div>

        </div>

        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    </t>

</templates>
