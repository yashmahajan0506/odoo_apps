<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_purchase_order" model="ir.ui.view">
        <field name="name">purchase.order.form.payment.term</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase_delivery_invoice']" position="after">
                <page string="Purchase Terms And Conditions" name="terms_conditions"
                      groups="wb_terms_and_conditions.group_po_tnc">
                <group name="terms_info" string="Terms And Conditions">
                        <group>
                            <field name="show_in_report"/>
                        </group>
                    </group>
                    <group>
                        <field name="term_conditions" domain="[('company_ids', 'in', company_id)]"/>
                        <field name="terms_detail"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
