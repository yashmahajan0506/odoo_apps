<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 	sale order form view inherited-->
    <record id="wb_sale_order_form_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="after">
                <page string="Sales Terms And Conditions" name="terms_conditions" groups="wb_terms_and_conditions.group_so_tnc">
                    <group name="terms_info" string="Terms And Conditions">
                        <group>
                            <field name="show_in_report"/>
                        </group>
                    </group>
                    <group>
                        <field name="term_conditions" domain="[('company_ids', 'in', company_id)]"/>
                        <field name="terms_detail" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
