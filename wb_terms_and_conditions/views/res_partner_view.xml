<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_property_form_terms_and_con" model="ir.ui.view">
        <field name="name">res.partner.carrier.terms.con.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='misc']" position="after">
                <group string=" Sales Default Terms and Condition" name="sales_term_conditions"
                 groups="wb_terms_and_conditions.group_so_tnc">
                    <field name="so_term_conditions" domain="[('company_ids', 'in', company_id)]"/>
                    <field name="so_terms_detail"/>
                </group>
                <group string="Purchase Default Terms and Condition" name="purchase_term_conditions"
                groups="wb_terms_and_conditions.group_po_tnc">
                    <field name="po_term_conditions" domain="[('company_ids', 'in', company_id)]"/>
                    <field name="po_terms_detail"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
