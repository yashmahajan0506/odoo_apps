<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wb_sale_term_and_con_view_form" model="ir.ui.view">
        <field name="name">wb.so.tems.and.condition.form</field>
        <field name="model">wb.so.tnc</field>
        <field name="arch" type="xml">
            <form string="Terms and Conditions">
                <sheet>
                    <group col="2" string="Terms And Conditions">
                        <field name="name" required="True"/>
                        <field name="terms_con"/>
                        <field name="company_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wb_sale_tems_and_con_view_tree" model="ir.ui.view">
        <field name="name">wb.so.tnc.list</field>
        <field name="model">wb.so.tnc</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="wb_so_terms_and_con_action" model="ir.actions.act_window">
        <field name="name">Terms and Conditions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">wb.so.tnc</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="term_conditions_sale_config_menu" groups="base.group_system" name="Terms And Conditions"
              parent="sale.menu_sale_config" action="wb_so_terms_and_con_action"/>

</odoo>
