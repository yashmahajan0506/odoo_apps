<?xml version='1.0' encoding='utf-8'?>
<odoo>
    
    <template id="report_invoice_tnc_inherit" inherit_id="account.report_invoice_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div groups="wb_terms_and_conditions.group_so_tnc">
                <t t-if="o.term_conditions and o.show_in_report == 'yes' ">
                    <strong>Terms Details:</strong>
                    <span t-field="o.terms_detail" />
                </t>
            </div>
            <div groups="wb_terms_and_conditions.group_po_tnc">
                <t t-if="o.po_term_conditions and o.show_in_report == 'yes' ">
                    <strong>Terms Details:</strong>
                    <span t-field="o.terms_detail" />
                </t>
            </div>
        </xpath>
    </template>

</odoo>
