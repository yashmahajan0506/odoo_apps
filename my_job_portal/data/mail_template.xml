<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="mail_template_job_application_shortlisted" model="mail.template">
    <field name="name">Job Application Shortlisted Email</field>
    <field name="model_id" ref="my_job_portal.model_my_job_portal_job_application"/>
            <field name="email_from">{{ user.email_formatted or 'noreply@yourcompany.com' }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Congratulations! Your Application for {{ object.job_id.name }} is Shortlisted</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <strong>{{ object.applicant_name }}</strong>,</p>
                    <p>We are pleased to inform you that your application for the position:</p>
                    <h3>{{ object.job_id.name }}</h3>
                    <p>has been <strong>shortlisted</strong>!</p>
                    <p>Our recruitment team will contact you soon for the next steps.</p>
                    <br/>
                    <p>Best regards,<br/>
                    <strong>{{ user.company_id.name }}</strong></p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>