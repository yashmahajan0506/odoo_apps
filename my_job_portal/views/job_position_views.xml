<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_job_position_list" model="ir.ui.view">
    <field name="name">job.position.list</field>
    <field name="model">my_job_portal.job.position</field>
    <field name="arch" type="xml">
    <list>
        <field name="name"/>
        <field name="department_id"/>
        <field name="total_openings"/>
        <field name="active"/>
    </list>
</field>
</record>


<record id="view_job_position_form" model="ir.ui.view">
    <field name="name">job.position.form</field>
    <field name="model">my_job_portal.job.position</field>
    <field name="arch" type="xml">
    <form>
       
        <sheet>
            <group>
                <field name="name"/>
                    <field name="department_id"/>
                    <field name="total_openings"/>
                    <field name="active"/>
            </group>
        <group>
                    <field name="description"/>
        </group>
       </sheet>
    </form>


    
</field>
</record>
<record id="view_job_position_search" model="ir.ui.view">
        <field name="name">job.position.search</field>
        <field name="model">my_job_portal.job.position</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Job Title"/>
                <field name="department_id"/>

            
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active','=',False)]"/>

            
                <group expand="1" string="Group By">
                    <filter name="group_department" string="Department" context="{'group_by':'department_id'}"/>
                    <filter name="group_active" string="Active" context="{'group_by':'active'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
