<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_job_application_form" model="ir.ui.view">
        <field name="name">job.application.form</field>
        <field name="model">my_job_portal.job.application</field>
        <field name="arch" type="xml">
            <form string="Job Application">
                 <button name="test_browse_metho" string="click me"
        />
                <header>
                    <button name="action_shortlist" type="object" string="Shortlist"
                            class="btn-primary"/>

                     <button name="action_reject" type="object" string="Reject"
                             class="btn-primary"/>

                     <button name="action_hire" type="object" string="Hire"
                             class="btn-primary"/>
                    
                       <field name="status" widget="statusbar" statusbar_visible="draft,Shortlist,Reject,Hire"/>
                
                </header>

                <sheet>
                    <group>
                        <field name="applicant_name"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="job_id"/>
                        <field name="status"/>
                        <field name="cv_attachment" filename="cv_filename"/>
                        <field name="application_count" readonly="1"/>
                    </group>
                </sheet>
            </form>
            
        </field>
    </record>

    <record id="view_job_application_tree" model="ir.ui.view">
        <field name="name">job.application.list</field>
        <field name="model">my_job_portal.job.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="applicant_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="job_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>


    <record id="view_job_application_search" model="ir.ui.view">
        <field name="name">job.application.search</field>
        <field name="model">my_job_portal.job.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="applicant_name"/>
                <field name="job_id"/>
                <field name="status"/>

             
                <filter name="submitted" string="Submitted" domain="[('status','=','submitted')]"/>
                <filter name="shortlisted" string="Shortlisted" domain="[('status','=','shortlisted')]"/>
                <filter name="rejected" string="Rejected" domain="[('status','=','rejected')]"/>

             
                <group expand="1" string="Group By">
                    <filter name="group_job" string="Job" context="{'group_by':'job_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>


</odoo>
